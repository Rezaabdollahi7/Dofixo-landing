---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro'
import Header from '../components/ui/Header.astro'
import FeaturesSlides from '../components/sections/FeaturesSlides.astro'
import Footer from '../components/sections/Footer.astro'
import Stats from '../components/sections/Stats.astro'
import About from '../components/sections/About.astro'
import Comparison from '../components/sections/Comparison.astro'
import FAQ from '../components/sections/FAQ.astro'
import Hero from '../components/sections/Hero.astro'
import Pricing from '../components/sections/Pricing.astro'
import Contact from '../components/sections/Contact.astro'
import Screenshots from '../components/sections/Screenshots.astro';
import { generalFaqs } from '../data/generalFaqs';
import { SITE, absoluteUrl } from '../data/site';
import { getImage } from 'astro:assets';
import heroImg from '../assets/site/hero-img.webp';

// همان srcset که Hero.astro می‌سازد؛ preload باید نزدیک‌ترین کاندید به
// اندازه‌ی نمایش روی گوشی (sizes="90vw" در اکثر گوشی‌ها) را هدف بگیرد، نه
// بزرگ‌ترین نسخه‌ی دسکتاپ را — وگرنه یک دانلود اضافه و بی‌ربط LCP را کند
// می‌کند. و باید به فایل بهینه‌شده اشاره کند، نه مسیر قدیمی در public/.
const preloadHeroImage = await getImage({ src: heroImg, width: 400 });

const title = 'نرم‌افزار مدیریت تعمیرگاه موبایل و لپ‌تاپ | دوفیکسو';
const description =
  'نرم‌افزار مدیریت تعمیرگاه دوفیکسو: پذیرش دستگاه، پیگیری وضعیت تعمیر، مدیریت مشتریان، انبار قطعات، فاکتور و گزارش مالی در یک پنل. ۳۰ روز رایگان.';

// قیمت‌ها با پلن‌های واقعی صفحه‌ی /pricing هم‌خوان است.
// صفحه قیمت‌ها را به تومان نشان می‌دهد؛ schema.org فقط کد ISO 4217 می‌پذیرد،
// پس مقادیر به ریال (۱ تومان = ۱۰ ریال) تبدیل شده‌اند.
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": `${SITE.url}/#software`,
  name: SITE.name,
  alternateName: SITE.nameEn,
  applicationCategory: "BusinessApplication",
  applicationSubCategory: "نرم‌افزار مدیریت تعمیرگاه",
  operatingSystem: "Web",
  url: `${SITE.url}/`,
  inLanguage: "fa-IR",
  description,
  featureList: [
    "ثبت و پذیرش دستگاه",
    "پیگیری وضعیت تعمیر",
    "مدیریت مشتریان تعمیرگاه",
    "مدیریت انبار و قطعات",
    "صدور فاکتور",
    "مدیریت مالی و گزارش‌گیری",
  ],
  publisher: { "@id": `${SITE.url}/#organization` },
  offers: {
    "@type": "AggregateOffer",
    priceCurrency: "IRR",
    lowPrice: "19700000",
    highPrice: "79900000",
    offerCount: 3,
    url: absoluteUrl("/pricing/"),
    availability: "https://schema.org/InStock",
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: generalFaqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<Layout
  title={title}
  description={description}
  preloadImage={preloadHeroImage.src}
  schema={[softwareSchema, faqSchema]}
>
  <Header />
  <main id="main-content">
    <Hero />
    <FeaturesSlides />
    <Comparison />
    <Screenshots />
    <Pricing />
    <Stats />
    <About />
    <Contact />
    <FAQ />
  </main>
  <Footer />
</Layout>
