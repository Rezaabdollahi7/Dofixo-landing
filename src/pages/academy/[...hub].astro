---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/ui/Header.astro";
import Footer from "../../components/sections/Footer.astro";
import Breadcrumbs from "../../components/academy/Breadcrumbs.astro";
import ArticleCard from "../../components/academy/ArticleCard.astro";
import CtaBlock from "../../components/academy/CtaBlock.astro";
import { SITE, absoluteUrl, breadcrumbSchema } from "../../data/site";
import { COURSE, publishedChapters } from "../../data/course";
import {
  SECTIONS,
  articlePath,
  authorPath,
  getArticles,
  getSectionArticles,
  sectionPath,
} from "../../lib/academy";

/**
 * صفحه‌ی اصلی مرکز آموزش: /academy/.
 *
 * مسیر rest با پارامتر خالی فقط همین یک صفحه را می‌سازد. شکلش این است، نه
 * academy/index.astro، تا وقتی هیچ مقاله‌ای منتشر نشده اصلاً ساخته نشود.
 */
export async function getStaticPaths() {
  return (await getArticles()).length > 0 ? [{ params: { hub: undefined } }] : [];
}

const articles = await getArticles();
const sections = await Promise.all(
  SECTIONS.map(async (s) => ({ ...s, articles: await getSectionArticles(s.key) })),
);
const visibleSections = sections.filter((s) => s.articles.length > 0);
const startHere = articles.find((a) => a.id === "tutorials/getting-started");
const latest = articles.slice(0, 6);
const chapters = publishedChapters();

// فقط نویسنده‌هایی که دست‌کم یک مقاله‌ی منتشرشده دارند
const authorIds = new Set(articles.map((a) => a.data.author.id));
const authors = (await getCollection("authors")).filter((a) => authorIds.has(a.id));

const crumbs = [
  { name: "خانه", path: "/" },
  { name: "مرکز آموزش", path: "/academy/" },
];

const description =
  "راهنما، آموزش قدم‌به‌قدم و تجربه‌ی واقعی برای اداره‌ی تعمیرگاه موبایل: پذیرش و رسید، انبار قطعات، فاکتور، حساب و کتاب، و کار با دوفیکسو.";

const hubSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${SITE.url}/academy/#page`,
  name: "مرکز آموزش دوفیکسو",
  description,
  url: absoluteUrl("/academy/"),
  inLanguage: "fa-IR",
  publisher: { "@id": `${SITE.url}/#organization` },
  hasPart: visibleSections.map((s) => ({
    "@type": "CollectionPage",
    name: s.name,
    url: absoluteUrl(sectionPath(s.key)),
  })),
};
---

<Layout
  title="مرکز آموزش دوفیکسو | راهنمای مدیریت تعمیرگاه موبایل"
  description={description}
  canonicalPath="/academy/"
  schema={[hubSchema, breadcrumbSchema(crumbs)]}
>
  <Header />

  <main id="main-content">
    <div class="max-w-content mx-auto px-4 mt-6">
      <Breadcrumbs items={crumbs} />

      <header class="text-center max-w-3xl mx-auto mt-10">
        <span class="inline-block bg-[#fdeeea] text-secondary font-bold text-sm rounded-full px-6 py-2 mb-4">مرکز آموزش</span>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-heading font-extrabold text-primary leading-tight">
          اداره‌ی <span class="text-secondary">تعمیرگاه موبایل</span>، از پذیرش تا سود
        </h1>
        <p class="text-primary/60 text-base md:text-lg mt-4 leading-[190%]">{description}</p>
        {
          startHere && (
            <a
              href={articlePath(startHere)}
              class="inline-flex items-center gap-2 mt-8 bg-secondary hover:bg-secondary/90 transition-colors text-white font-bold rounded-[12px] px-7 h-12"
            >
              از اینجا شروع کنید: {startHere.data.title}
            </a>
          )
        }
      </header>

      <nav aria-label="بخش‌های مرکز آموزش" class="mt-14 grid grid-cols-1 md:grid-cols-3 gap-5">
        {
          visibleSections.map((s) => (
            <a href={sectionPath(s.key)} class="group bg-[#f8f9fb] hover:bg-white hover:shadow-8 transition-all rounded-[24px] p-6">
              <span class="text-xs font-bold text-secondary">
                {s.articles.length.toLocaleString("fa-IR")} {s.key === "tutorials" ? "آموزش" : "مقاله"}
              </span>
              <h2 class="font-heading font-extrabold text-xl text-primary mt-2 group-hover:text-secondary transition-colors">{s.name}</h2>
              <p class="text-sm text-primary/60 leading-[200%] mt-2">{s.description}</p>
            </a>
          ))
        }
      </nav>

      {
        chapters.length > 0 && (
          <section class="mt-16 bg-primary text-white rounded-[24px] sm:rounded-[30px] p-6 sm:p-10 flex flex-col md:flex-row md:items-center gap-6" aria-labelledby="course-heading">
            <div class="flex-1">
              <h2 id="course-heading" class="font-heading font-extrabold text-2xl">{COURSE.title}</h2>
              <p class="text-white/60 leading-[200%] mt-3">{COURSE.description}</p>
              <p class="text-white/40 text-sm mt-2">{chapters.length.toLocaleString("fa-IR")} فصل ویدیویی</p>
            </div>
            <a href="/academy/course/" class="shrink-0 inline-flex items-center justify-center bg-secondary hover:bg-secondary/90 transition-colors text-white font-bold rounded-[12px] px-7 h-12">
              تماشای دوره
            </a>
          </section>
        )
      }

      <section class="mt-16" aria-labelledby="latest-heading">
        <h2 id="latest-heading" class="font-heading font-extrabold text-2xl text-primary mb-6">تازه‌ترین‌ها</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {latest.map((a) => <ArticleCard article={a} />)}
        </div>
      </section>

      {
        authors.length > 0 && (
          <section class="mt-16" aria-labelledby="authors-heading">
            <h2 id="authors-heading" class="font-heading font-extrabold text-2xl text-primary mb-6">نویسنده‌ها</h2>
            <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
              {authors.map((a) => (
                <li>
                  <a href={authorPath(a.id)} class="group flex items-center gap-3 bg-[#f8f9fb] hover:bg-white hover:shadow-8 transition-all rounded-[18px] p-4">
                    <Image src={a.data.avatar} alt="" width={56} height={56} class="w-12 h-12 rounded-full shrink-0" />
                    <span class="min-w-0">
                      <span class="block font-bold text-primary group-hover:text-secondary transition-colors">{a.data.name}</span>
                      <span class="block text-xs text-primary/50 line-clamp-1">{a.data.role}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <div class="max-w-4xl mx-auto mt-16 mb-20">
        <CtaBlock />
      </div>
    </div>
  </main>

  <Footer />
</Layout>
