---
// src/pages/features.astro
//
// امکانات دوفیکسو، ماژول به ماژول، هر کدام با اسکرین‌شات واقعی خودش
// (src/data/appScreens.ts). کلیک روی هر تصویر لایت‌باکس را باز می‌کند.
//
// هر جمله‌ی این صفحه باید در docs/academy/product-facts.md پشتوانه داشته
// باشد. نسخه‌ی قبلی چند چیز ناموجود را وعده می‌داد («تاریخچه‌ی کامل دستگاه»،
// جستجوی مشتری با سریال، «هشدار کمبود موجودی»)؛ قابلیتی که آن‌جا نیست
// این‌جا هم نمی‌آید.
import Layout from "../layouts/Layout.astro";
import Header from "../components/ui/Header.astro";
import Footer from "../components/sections/Footer.astro";
import ShotLightbox from "../components/ui/ShotLightbox.astro";
import { Image } from "astro:assets";
import { screens, type AppScreen } from "../data/appScreens";
import { absoluteUrl, breadcrumbSchema } from "../data/site";

interface Point {
  title: string;
  text: string;
}
interface Module {
  id: string;
  title: string;
  lead: string;
  screen: AppScreen;
  points: Point[];
  link?: { href: string; label: string };
}

const modules: Module[] = [
  {
    id: "intake",
    title: "پذیرش دستگاه",
    lead: "مشتری جلوی پیشخوان ایستاده؛ ثبت دستگاه نباید بیشتر از حرف زدن با او طول بکشد. مشتری را با نام یا شماره پیدا می‌کنید یا همان‌جا می‌سازید، مشخصات دستگاه را می‌نویسید و تعمیرکار را انتخاب می‌کنید.",
    screen: screens.newDevice,
    points: [
      { title: "شماره‌ی پذیرش اختصاصی", text: "پشت‌سرهم و بدون جاافتادگی؛ همان شماره روی فاکتور و در پیامک مشتری می‌آید." },
      { title: "مشخصات کامل دستگاه", text: "برند، مدل، شماره سریال، تاریخ ورود، و ایرادی که مشتری می‌گوید." },
      { title: "عکس از دستگاه", text: "چند عکس برای هر دستگاه؛ خصوصی نگه داشته می‌شوند و فقط با لینک موقت نمایش داده می‌شوند." },
      { title: "پیامک پذیرش", text: "مشتری با شماره‌ی پذیرش پیامک می‌گیرد. اگر نخواهید، با یک کلیک خاموش می‌شود." },
    ],
    link: { href: "/academy/tutorials/device-intake/", label: "آموزش پذیرش دستگاه" },
  },
  {
    id: "statuses",
    title: "وضعیت تعمیر و پیامک به مشتری",
    lead: "هر دستگاه همیشه یک وضعیت روشن دارد، و مشتری در سه لحظه‌ی مهم خودکار خبردار می‌شود. لازم نیست برای هر دستگاهِ آماده تلفن بزنید.",
    screen: screens.statusSms,
    points: [
      { title: "وضعیت‌های ثابت و روشن", text: "از «در انتظار بررسی» و «در انتظار قطعه» تا «تحویل داده شده»، به‌علاوه‌ی «غیرقابل تعمیر» و «تعمیر نشد»." },
      { title: "پیامک در سه لحظه", text: "پذیرش، آماده تحویل و تحویل — با نام تعمیرگاه و شماره‌ی پذیرش دستگاه." },
      { title: "تصمیم با شماست", text: "پیش از فرستادن، دوفیکسو می‌پرسد پیامک برود یا نه." },
      { title: "کیف پول پیامکی جدا", text: "هزینه‌ی پیامک از کیف پول خود تعمیرگاه کم می‌شود، با شارژ آنلاین. اگر ارسال شکست بخورد، پول برمی‌گردد." },
    ],
    link: { href: "/academy/tutorials/device-statuses/", label: "آموزش وضعیت دستگاه" },
  },
  {
    id: "customers",
    title: "پرونده‌ی مشتری",
    lead: "سابقه‌ی هر مشتری در یک صفحه: چه آورده، چه تعمیری شده، چقدر پرداخته و چه نکته‌ای باید درباره‌اش بدانید.",
    screen: screens.customerPage,
    points: [
      { title: "دستگاه‌ها و خط زمانی", text: "همه‌ی دستگاه‌هایی که آورده، با تاریخ ثبت، فاکتور و تحویل هر کدام." },
      { title: "فاکتورها و مانده", text: "فاکتورهای مشتری و مبلغی که هنوز پرداخت نکرده." },
      { title: "یادداشت خصوصی", text: "مثل «دیر تسویه می‌کند» — فقط کارکنان می‌بینند و روی فاکتور چاپ نمی‌شود." },
      { title: "بدون سقف", text: "تعداد مشتری، دستگاه و کاربر محدود نیست." },
    ],
  },
  {
    id: "team",
    title: "تعمیرکاران و دسترسی‌ها",
    lead: "هر دستگاه مسئول مشخص دارد و هر تعمیرکار فقط چیزی را می‌بیند که برای کارش لازم است.",
    screen: screens.technician,
    points: [
      { title: "سپردن دستگاه", text: "هر دستگاه به یک یا چند تعمیرکار سپرده می‌شود و تاریخچه‌ی سپردن‌ها می‌ماند." },
      { title: "صفحه‌ی هر تعمیرکار", text: "دستگاه‌های فعال، تعمیرهای تکمیل‌شده، نرخ تعمیر موفق، میانگین زمان تعمیر و نمودار ماهانه." },
      { title: "بار کاری روی داشبورد", text: "در یک نگاه می‌بینید دست کدام تعمیرکار پر است." },
      { title: "سه نقش", text: "سوپر ادمین، ادمین و تکنسین. تکنسین فقط دستگاه‌ها و مشتری‌ها را می‌بیند، نه حساب و کتاب را." },
    ],
  },
  {
    id: "inventory",
    title: "انبار و قطعات",
    lead: "موجودی با هر فاکتور خودکار جابه‌جا می‌شود: قطعه‌ای که روی فاکتور تعمیر رفته، از انبار هم کم شده.",
    screen: screens.items,
    points: [
      { title: "کالا با کد و دسته‌بندی", text: "کد، نام، دسته، واحد، حداقل موجودی و موجودی اولیه برای هر قطعه." },
      { title: "به‌روز با هر فاکتور", text: "فاکتور خرید موجودی را زیاد می‌کند و فاکتور فروش و تعمیر کم." },
      { title: "قیمت تمام‌شده‌ی واقعی", text: "میانگین موزون خریدها، حتی وقتی قیمت قطعه هر هفته عوض می‌شود." },
      { title: "کم‌موجودها و گردش کالا", text: "کالاهای کم‌موجود در داشبورد و گزارش موجودی؛ ورود و خروج هر کالا با تاریخ و قیمت." },
    ],
  },
  {
    id: "invoices",
    title: "فاکتور و پرداخت",
    lead: "سه نوع فاکتور — خرید، فروش و تعمیر — با شماره‌ی پشت‌سرهم، و چاپ با لوگو و اطلاعات خود تعمیرگاه.",
    screen: screens.repairInvoice,
    points: [
      { title: "فاکتور تعمیر وصل به دستگاه", text: "مشتری خودکار پر می‌شود؛ قطعه و اجرت در یک فاکتور، با تخفیف و مالیات." },
      { title: "پرداخت در چند نوبت", text: "نقدی، کارت یا انتقال وجه، با شماره پیگیری و تاریخ هر پرداخت." },
      { title: "گارانتی خودکار", text: "تعداد ماه را می‌نویسید؛ تاریخ پایان حساب می‌شود و روی فاکتور چاپی می‌آید." },
      { title: "ویرایش بی‌دردسر", text: "هر سه نوع فاکتور قابل ویرایش‌اند و انبار هم‌پایشان اصلاح می‌شود؛ شماره‌ی فاکتور عوض نمی‌شود." },
    ],
  },
  {
    id: "reports",
    title: "گزارش‌ها و داشبورد",
    lead: "سود هر ماه را از روی فاکتورها می‌بینید، نه از روی حدس — با بهای تمام‌شده‌ی واقعی هر قطعه.",
    screen: screens.profitReport,
    points: [
      { title: "داشبورد", text: "دستگاه‌های در کار، توزیع وضعیت‌ها، درآمد امروز و این ماه، روند ۱۴ روز و فاکتورهای در انتظار پرداخت." },
      { title: "سود و زیان", text: "در هر بازه‌ی تاریخ: فروش، بهای تمام‌شده، سود خالص و حاشیه‌ی سود — به تفکیک کالا." },
      { title: "گزارش موجودی", text: "موجودی هر کالا، حداقل آن و ارزش ریالی کل انبار." },
      { title: "خروجی اکسل", text: "از مشتری‌ها، دستگاه‌ها، کالاها و فاکتورها." },
    ],
  },
];

const phones = [screens.devicesMobile, screens.dashboardMobile, screens.customerPageMobile];

const trust = [
  { title: "اطلاعات هر تعمیرگاه جداست", text: "جداسازی در خود پایگاه‌داده انجام می‌شود، نه فقط در برنامه.", icon: "M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-3z" },
  { title: "پشتیبان‌گیری روزانه", text: "خودکار، رمزنگاری‌شده، روی فضای ابری جداگانه.", icon: "M4 7c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3zm0 0v10c0 1.7 3.6 3 8 3s8-1.3 8-3V7M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3" },
  { title: "چیزی پاک نمی‌شود", text: "اگر اشتراک تمدید نشود، حساب فقط‌خواندنی می‌شود و اطلاعات سر جایش می‌ماند.", icon: "M8 11V7a4 4 0 118 0v4M6 11h12v9H6z" },
  { title: "انتقال اطلاعات قبلی", text: "اگر اکسل یا نرم‌افزار دیگری دارید، تیم دوفیکسو اطلاعات را منتقل می‌کند.", icon: "M7 7h11l-3-3m3 3l-3 3M17 17H6l3 3m-3-3l3-3" },
  { title: "روی هر دستگاهی", text: "تحت وب؛ بدون نصب، روی کامپیوتر، تبلت و گوشی. به اینترنت نیاز دارد.", icon: "M4 5h16v11H4zM9 20h6M12 16v4" },
  { title: "پشتیبانی ۲۴ ساعته", text: "تلفن و تلگرام، برای وقتی که کار گیر کرده.", icon: "M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a1 1 0 01-1 1A16 16 0 014 5a1 1 0 011-1z" },
];

// ترتیب لایت‌باکس: ماژول‌ها به ترتیب صفحه، بعد گوشی‌ها
const lightbox = [...modules.map((m) => m.screen), ...phones];
const toFa = (n: number) => n.toLocaleString("fa-IR", { minimumIntegerDigits: 2 });

const breadcrumb = breadcrumbSchema([
  { name: "خانه", path: "/" },
  { name: "امکانات", path: "/features" },
]);

// فهرست ماژول‌ها دقیقاً همان چیزی است که در صفحه دیده می‌شود.
const featureListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "امکانات نرم‌افزار مدیریت تعمیرگاه دوفیکسو",
  url: absoluteUrl("/features/"),
  itemListElement: modules.map((m, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: m.title,
    url: absoluteUrl(`/features/#${m.id}`),
  })),
};
---

<Layout
  title="امکانات نرم‌افزار مدیریت تعمیرگاه دوفیکسو | پذیرش تا فاکتور"
  description="پذیرش دستگاه با شماره‌ی اختصاصی، وضعیت تعمیر و پیامک خودکار به مشتری، پرونده‌ی مشتری، انبار با قیمت تمام‌شده‌ی واقعی، فاکتور تعمیر و گزارش سود و زیان — با تصویرهای واقعی از نرم‌افزار."
  schema={[featureListSchema, breadcrumb]}
>
  <Header />
  <main id="main-content" class="mt-8 sm:pt-16 pt-20 relative">
    <img alt="" aria-hidden="true" src="/images/Vector72.webp" width="1408" height="557" loading="lazy" decoding="async" class="absolute right-0 -top-20 hidden md:block pointer-events-none" />
    <img alt="" aria-hidden="true" src="/images/Vector73.webp" width="1408" height="737" loading="lazy" decoding="async" class="absolute right-0 -top-20 hidden md:block pointer-events-none" />

    <nav aria-label="مسیر صفحه" class="max-w-content mx-auto px-4 text-xs text-primary/40 flex items-center gap-2 relative z-10">
      <a href="/" class="hover:text-secondary transition-colors">خانه</a>
      <span aria-hidden="true">/</span>
      <span class="text-primary/70">امکانات</span>
    </nav>

    <!-- سرصفحه -->
    <header class="text-center mt-10 sm:mt-12 relative z-10 px-4">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-heading font-extrabold text-primary leading-tight">
        امکانات نرم‌افزار مدیریت تعمیرگاه <span class="text-secondary">دوفیکسو</span>
      </h1>
      <p class="text-charcoal/70 text-base md:text-lg mt-5 max-w-2xl mx-auto leading-[200%]">
        از لحظه‌ای که گوشی روی پیشخوان گذاشته می‌شود تا روزی که سود ماه را حساب می‌کنید. همه‌ی تصویرهای این صفحه از خود نرم‌افزارند، روی اطلاعات یک تعمیرگاه موبایل نمونه.
      </p>
      <ul class="feat-chips mt-8 flex sm:flex-wrap sm:justify-center gap-2 max-w-3xl mx-auto max-sm:-mx-4 max-sm:px-4 max-sm:overflow-x-auto">
        {modules.map((m, i) => (
          <li>
            <a href={`#${m.id}`} class="whitespace-nowrap inline-flex items-center gap-2 h-10 px-4 rounded-full bg-white border border-lavender text-sm font-bold text-primary/75 hover:text-secondary hover:border-secondary/40 transition-colors">
              <span class="text-secondary text-xs">{toFa(i + 1)}</span>
              {m.title}
            </a>
          </li>
        ))}
      </ul>
    </header>

    <!-- ماژول‌ها -->
    <div class="max-w-content mx-auto px-4 mt-14 sm:mt-20 relative z-10 space-y-8 sm:space-y-12">
      {modules.map((m, i) => (
        <section id={m.id} aria-labelledby={`${m.id}-heading`} class="scroll-mt-6 bg-white rounded-[24px] sm:rounded-[32px] border border-lavender shadow-[0_30px_80px_-50px_rgba(17,14,45,0.35)] p-4 sm:p-8 lg:p-10">
          <div class:list={["grid lg:grid-cols-12 gap-6 lg:gap-12 items-center", i % 2 === 1 && "lg:[&>*:first-child]:order-2"]}>
            <!-- تصویر -->
            <div class="lg:col-span-7">
              <button
                type="button"
                data-shot={i}
                aria-label={`بزرگ‌نمایی تصویر ${m.screen.title}`}
                class="group block w-full text-right rounded-[16px] sm:rounded-[22px] bg-[#F1F4F7] p-2 sm:p-3 cursor-zoom-in focus-visible:outline-2 focus-visible:outline-secondary"
              >
                <span class="block rounded-[10px] sm:rounded-[14px] overflow-hidden bg-white border border-lavender-1 shadow-[0_20px_40px_-24px_rgba(17,14,45,0.35)] transition-transform duration-300 group-hover:-translate-y-1">
                  <span class="flex items-center gap-1.5 px-3 h-6 sm:h-7 bg-[#f7f8fa] border-b border-lavender-1" dir="ltr" aria-hidden="true">
                    <i class="size-2 sm:size-2.5 rounded-full bg-[#ff5f57]"></i>
                    <i class="size-2 sm:size-2.5 rounded-full bg-[#febc2e]"></i>
                    <i class="size-2 sm:size-2.5 rounded-full bg-[#28c840]"></i>
                  </span>
                  <Image
                    src={m.screen.image}
                    alt={`${m.screen.title} در نرم‌افزار دوفیکسو: ${m.screen.caption}`}
                    widths={[640, 960, 1440]}
                    sizes="(min-width: 1280px) 700px, (min-width: 1024px) 56vw, 92vw"
                    loading={i === 0 ? "eager" : "lazy"}
                    class="w-full h-auto block"
                  />
                </span>
                <span class="flex items-center justify-center gap-1.5 mt-2.5 text-xs text-primary/50 group-hover:text-secondary transition-colors">
                  <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path stroke-linecap="round" d="M20 20l-3.5-3.5M11 8v6M8 11h6" /></svg>
                  {m.screen.caption}
                </span>
              </button>
            </div>

            <!-- متن -->
            <div class="lg:col-span-5">
              <p class="flex items-center gap-2 text-xs font-bold">
                <span class="text-secondary">{toFa(i + 1)}</span>
                <span class="h-px w-6 bg-secondary/40"></span>
                <span class="text-primary/40">ماژول</span>
              </p>
              <h2 id={`${m.id}-heading`} class="mt-3 font-heading font-extrabold text-2xl sm:text-3xl text-primary leading-tight">{m.title}</h2>
              <p class="mt-3 text-[15px] sm:text-base leading-[200%] text-charcoal/80">{m.lead}</p>
              <dl class="mt-6 space-y-4">
                {m.points.map((p) => (
                  <div class="flex items-start gap-3">
                    <span class="mt-1 size-5 shrink-0 rounded-full bg-linen-1 text-secondary flex items-center justify-center" aria-hidden="true">
                      <svg class="size-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                    </span>
                    <div>
                      <dt class="font-bold text-[15px] text-primary">{p.title}</dt>
                      <dd class="mt-0.5 text-sm leading-[190%] text-charcoal/70">{p.text}</dd>
                    </div>
                  </div>
                ))}
              </dl>
              {m.link && (
                <a href={m.link.href} class="mt-6 inline-flex items-center gap-1.5 text-sm font-bold text-primary hover:text-secondary transition-colors">
                  {m.link.label}
                  <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
                </a>
              )}
            </div>
          </div>
        </section>
      ))}
    </div>

    <!-- روی گوشی -->
    <section aria-labelledby="mobile-heading" class="max-w-content mx-auto px-4 mt-20 sm:mt-28 relative z-10">
      <div class="rounded-[24px] sm:rounded-[32px] bg-primary text-white p-6 sm:p-10 lg:p-14 overflow-hidden relative">
        <div class="grid lg:grid-cols-12 gap-10 items-center">
          <div class="lg:col-span-5">
            <h2 id="mobile-heading" class="font-heading font-extrabold text-2xl sm:text-4xl leading-tight">
              روی گوشی هم، <span class="text-secondary">بدون نصب</span>
            </h2>
            <p class="mt-4 text-white/75 leading-[200%]">
              دوفیکسو تحت وب است: روی مرورگر کامپیوتر، تبلت یا گوشی باز می‌شود و همه‌ی امکاناتش آن‌جاست. وقتی بیرون از مغازه‌اید، وضعیت دستگاه‌ها و درآمد روز را از روی گوشی می‌بینید.
            </p>
            <p class="mt-3 text-sm text-white/50 leading-[190%]">برای کار به اینترنت نیاز دارد؛ حالت آفلاین ندارد.</p>
          </div>
          <div class="lg:col-span-7">
            <div class="flex justify-center items-end gap-3 sm:gap-5">
              {phones.map((p, k) => (
                <button
                  type="button"
                  data-shot={modules.length + k}
                  aria-label={`بزرگ‌نمایی تصویر ${p.title}`}
                  class:list={["group w-[31%] max-w-[210px] cursor-zoom-in text-center", k === 1 ? "sm:-translate-y-6" : ""]}
                >
                  <span class="block rounded-[22px] sm:rounded-[30px] bg-[#16142b] p-1.5 sm:p-2 shadow-[inset_0_0_0_2px_#2d2a4a,0_30px_50px_-20px_rgba(0,0,0,0.6)] transition-transform duration-300 group-hover:-translate-y-1">
                    <span class="block rounded-[17px] sm:rounded-[23px] overflow-hidden bg-white aspect-[840/1500]">
                      <Image src={p.image} alt={`${p.title}: ${p.caption}`} widths={[240, 420]} sizes="(min-width: 640px) 210px, 30vw" loading="lazy" class="w-full h-full object-cover object-top" />
                    </span>
                  </span>
                  <span class="block mt-3 text-xs sm:text-sm text-white/70">{p.title}</span>
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- اطمینان -->
    <section aria-labelledby="trust-heading" class="max-w-content mx-auto px-4 mt-20 sm:mt-28 relative z-10">
      <div class="text-center">
        <h2 id="trust-heading" class="font-heading font-extrabold text-2xl sm:text-4xl text-primary">اطلاعات تعمیرگاه، امن و مال خودتان</h2>
        <p class="mt-3 text-charcoal/70 max-w-2xl mx-auto leading-[200%]">پشت هر پذیرش و فاکتور، اطلاعات مشتری‌های شماست. این‌ها چیزهایی است که برای نگه داشتنش انجام می‌دهیم.</p>
      </div>
      <ul class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
        {trust.map((t) => (
          <li class="bg-white rounded-[20px] border border-lavender p-5 sm:p-6 flex gap-4">
            <span class="size-11 shrink-0 rounded-[12px] bg-linen-1 text-secondary flex items-center justify-center" aria-hidden="true">
              <svg class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d={t.icon} /></svg>
            </span>
            <div>
              <h3 class="font-bold text-primary">{t.title}</h3>
              <p class="mt-1 text-sm leading-[190%] text-charcoal/70">{t.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- دعوت به شروع -->
    <section class="max-w-content mx-auto px-4 mt-20 sm:mt-28 mb-24 relative z-10">
      <div class="rounded-[24px] sm:rounded-[32px] bg-linen-1 border border-secondary/15 p-6 sm:p-12 text-center">
        <h2 class="font-heading font-extrabold text-2xl sm:text-4xl text-primary">۳۰ روز رایگان، با همه‌ی امکانات</h2>
        <p class="mt-4 text-charcoal/75 max-w-xl mx-auto leading-[200%]">
          برای شروع، اطلاعات پرداخت نمی‌خواهیم. بعد از آن هم پلن‌ها فقط در مدت و قیمت فرق دارند؛ هر چه در این صفحه دیدید، در همه‌ی پلن‌ها هست.
        </p>
        <div class="mt-7 flex flex-wrap justify-center gap-3">
          <a href="https://app.dofixo.ir/register" rel="noopener" class="bg-secondary btnHover inline-flex items-center justify-center h-12 px-8 rounded-[12px] text-white font-bold">
            شروع ۳۰ روز رایگان
          </a>
          <a href="/pricing/" class="inline-flex items-center justify-center h-12 px-8 rounded-[12px] bg-white text-primary font-bold border border-lavender hover:border-primary/30 transition-colors">
            مشاهده‌ی قیمت‌ها
          </a>
        </div>
      </div>
    </section>

    <ShotLightbox shots={lightbox} />
  </main>
  <Footer />
</Layout>

<style>
  /* روی گوشی برچسب‌های ماژول یک ردیف افقی‌اند، نه هفت ردیف روی هم */
  .feat-chips {
    scrollbar-width: none;
  }
  .feat-chips::-webkit-scrollbar {
    display: none;
  }
</style>
