---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/ui/Header.astro";
import Footer from "../../components/sections/Footer.astro";
import BlogCard from "../../components/sections/BlogCard.astro";
import ArticleIllustration from "../../components/sections/ArticleIllustration.astro";
import { SITE, absoluteUrl, breadcrumbSchema } from "../../data/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) =>
    import.meta.env.PROD ? data.draft !== true : true
  );

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

const iconLabels: Record<string, string> = {
  repair: "راهنمای تعمیر",
  inventory: "مدیریت انبار",
  pricing: "قیمت‌گذاری",
  customer: "مشتری‌مداری",
  general: "دوفیکسو",
};

const formattedDate = new Intl.DateTimeFormat("fa-IR", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(post.data.publishDate);

const wordsCount = post.body?.split(/\s+/).filter(Boolean).length ?? 0;
const readingMinutes = Math.max(1, Math.round(wordsCount / 180));

const relatedPosts = allPosts
  .filter((p) => p.id !== post.id)
  .filter((p) => p.data.tags.some((t: string) => post.data.tags.includes(t)))
  .slice(0, 3);

const postUrl = absoluteUrl(`/blog/${post.id}/`);
const publishedISO = post.data.publishDate.toISOString();
const modifiedISO = (post.data.updatedDate ?? post.data.publishDate).toISOString();

const postSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: publishedISO,
  dateModified: modifiedISO,
  inLanguage: "fa-IR",
  keywords: post.data.tags,
  wordCount: wordsCount,
  author: { "@type": "Organization", name: post.data.author, url: `${SITE.url}/` },
  publisher: { "@id": `${SITE.url}/#organization` },
  isPartOf: { "@id": `${SITE.url}/blog/#blog` },
  mainEntityOfPage: postUrl,
  url: postUrl,
};

const breadcrumb = breadcrumbSchema([
  { name: "خانه", path: "/" },
  { name: "بلاگ", path: "/blog" },
  { name: post.data.title, path: `/blog/${post.id}` },
]);

const schema = [postSchema, breadcrumb];
---

<Layout
  title={`${post.data.title} | بلاگ دوفیکسو`}
  description={post.data.description}
  canonicalPath={`/blog/${post.id}`}
  ogType="article"
  publishedTime={publishedISO}
  modifiedTime={modifiedISO}
  schema={schema}
>
  <Header />

  <main id="main-content">
  <article class="mt-10">
    <div class="max-w-content mx-auto px-4">
      <!-- Breadcrumb -->
      <nav aria-label="مسیر صفحه" class="text-xs text-primary/40 flex items-center gap-2 mb-6">
        <a href="/" class="hover:text-secondary transition-colors">خانه</a>
        <span aria-hidden="true">/</span>
        <a href="/blog" class="hover:text-secondary transition-colors">بلاگ</a>
        <span aria-hidden="true">/</span>
        <span class="text-primary/70 line-clamp-1">{post.data.title}</span>
      </nav>

      <header class="max-w-3xl mx-auto text-center">
        {
          post.data.tags?.length > 0 && (
            <div class="flex flex-wrap justify-center gap-2 mb-4">
              {post.data.tags.map((tag: string) => (
                <span class="text-[11px] font-bold text-secondary bg-[#fdeeea] rounded-full px-3 py-1">
                  {tag}
                </span>
              ))}
            </div>
          )
        }

        <h1 class="text-3xl md:text-4xl lg:text-[42px] font-heading font-extrabold text-primary leading-[140%]">
          {post.data.title}
        </h1>

        <div class="flex items-center justify-center gap-4 mt-5 text-sm text-primary/50">
          <span>{post.data.author}</span>
          <span class="w-1 h-1 rounded-full bg-primary/20"></span>
          <time datetime={post.data.publishDate.toISOString().slice(0, 10)}>{formattedDate}</time>
          <span class="w-1 h-1 rounded-full bg-primary/20"></span>
          <span>{readingMinutes} دقیقه مطالعه</span>
        </div>
      </header>

      <div class="max-w-4xl mx-auto mt-8 rounded-[20px] sm:rounded-[30px] overflow-hidden shadow-2">
        {
          post.data.coverImage ? (
            <Image
              src={post.data.coverImage}
              alt={post.data.coverImageAlt ?? post.data.title}
              width={1200}
              height={675}
              class="w-full h-auto object-cover"
            />
          ) : (
            <img
              src={`/images/blog-covers/cover-${post.data.icon}.svg`}
              alt={post.data.coverImageAlt ?? post.data.title}
              width="1200"
              height="675"
              fetchpriority="high"
              decoding="async"
              class="w-full h-auto object-cover aspect-[16/9]"
            />
          )
        }
      </div>

      <div class="max-w-6xl mx-auto mt-10 pb-16 grid grid-cols-1 lg:grid-cols-[1fr_300px] gap-10 items-start">
        <div
          class="prose-dofixo min-w-0 text-primary/80 leading-[220%] text-justify
                 [&_h2]:font-heading [&_h2]:font-extrabold [&_h2]:text-primary [&_h2]:text-2xl [&_h2]:mt-10 [&_h2]:mb-4 [&_h2]:scroll-mt-28
                 [&_h3]:font-heading [&_h3]:font-bold [&_h3]:text-primary [&_h3]:text-xl [&_h3]:mt-8 [&_h3]:mb-3 [&_h3]:scroll-mt-28
                 [&_p]:mb-5
                 [&_ul]:list-disc [&_ul]:pr-6 [&_ul]:mb-5 [&_ol]:list-decimal [&_ol]:pr-6 [&_ol]:mb-5
                 [&_li]:mb-2
                 [&_a]:text-secondary [&_a]:font-bold [&_a]:underline [&_a]:underline-offset-4
                 [&_strong]:text-primary [&_strong]:font-bold
                 [&_blockquote]:border-r-4 [&_blockquote]:border-secondary [&_blockquote]:pr-4 [&_blockquote]:text-primary/60"
        >
          <Content />
        </div>

        <!-- سایدبار: فهرست مطالب + تصویر مرتبط -->
        <aside class="hidden lg:block">
          <div class="sticky top-24 space-y-5">
            {tocHeadings.length > 0 && (
              <nav aria-label="فهرست مطالب" class="bg-[#f8f9fb] rounded-[18px] p-5">
                <p class="text-xs font-bold text-primary/40 mb-3">فهرست مطالب</p>
                <ul class="space-y-2.5 text-sm border-r-2 border-[#110e2d0d] pr-3" role="list">
                  {tocHeadings.map((h) => (
                    <li class={h.depth === 3 ? "pr-3" : ""}>
                      <a
                        href={`#${h.slug}`}
                        class="toc-link block text-primary/60 hover:text-secondary transition-colors leading-6"
                        data-slug={h.slug}
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            )}

            <ArticleIllustration topic={post.data.icon} label={iconLabels[post.data.icon]} />

            <div class="bg-primary rounded-[18px] p-5 text-white">
              <p class="font-heading font-extrabold text-sm mb-2">دموی رایگان دوفیکسو رو ببین</p>
              <p class="text-xs text-white/60 leading-6 mb-4">
                مدیریت تعمیرگاهت رو با یه نرم‌افزار ساده و سریع شروع کن.
              </p>
              <a  href="https://app.dofixo.ir" target="_blank" rel="noopener" class="block text-center bg-secondary hover:bg-secondary/90 transition-colors text-white text-sm font-bold rounded-lg py-2.5">
                شروع با دمو
              </a>
            </div>
          </div>
        </aside>
      </div>

      {
        relatedPosts.length > 0 && (
          <div class="max-w-content mx-auto pb-20">
            <h2 class="font-heading font-extrabold text-2xl text-primary text-center mb-8">
              مقالات مرتبط
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              {relatedPosts.map((related) => (
                <BlogCard
                  href={`/blog/${related.id}`}
                  title={related.data.title}
                  description={related.data.description}
                  publishDate={related.data.publishDate}
                  tags={related.data.tags}
                  coverImage={related.data.coverImage}
                  coverImageAlt={related.data.coverImageAlt}
                  icon={related.data.icon}
                />
              ))}
            </div>
          </div>
        )
      }
    </div>
  </article>
  </main>

  <Footer />
</Layout>

<script>
  function initTocScrollSpy() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".toc-link"));
    if (links.length === 0) return;

    const headingEls = links
      .map((link) => document.getElementById(link.dataset.slug || ""))
      .filter((el): el is HTMLElement => !!el);

    if (headingEls.length === 0) return;

    const setActive = (slug: string) => {
      links.forEach((link) => {
        const isActive = link.dataset.slug === slug;
        link.classList.toggle("text-secondary", isActive);
        link.classList.toggle("font-bold", isActive);
        link.classList.toggle("text-primary/60", !isActive);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            setActive(entry.target.id);
          }
        });
      },
      { rootMargin: "-100px 0px -70% 0px" }
    );

    headingEls.forEach((el) => observer.observe(el));
  }

  document.addEventListener("astro:page-load", initTocScrollSpy);
  initTocScrollSpy();
</script>
