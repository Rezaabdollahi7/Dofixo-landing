---
import "../styles/global.css";
import JsonLd from "../components/seo/JsonLd.astro";
import {
  SITE,
  canonicalPathname,
  organizationSchema,
  websiteSchema,
} from "../data/site";

interface Props {
  title: string;
  description: string;
  ogImage?: string;      // مسیر نسبی، مثلاً "/images/og-default.jpg"
  ogImageAlt?: string;
  ogType?: "website" | "article";
  canonicalPath?: string; // مثلاً "/pricing" — اگر ندی، از Astro.url ساخته می‌شه
  noindex?: boolean;
  schema?: Record<string, any> | Record<string, any>[]; // JSON-LD اختصاصی صفحه
  /** متادیتای مقاله؛ فقط وقتی ogType === "article" معنی دارد */
  publishedTime?: string;
  modifiedTime?: string;
  /** تصویر LCP صفحه؛ فقط برای صفحه‌ای بده که تصویر بزرگ above-the-fold دارد */
  preloadImage?: string;
}

const {
  title,
  description,
  ogImage = SITE.ogImage,
  ogImageAlt = `${SITE.name} — نرم‌افزار مدیریت تعمیرگاه`,
  ogType = "website",
  canonicalPath,
  noindex = false,
  schema,
  publishedTime,
  modifiedTime,
  preloadImage,
} = Astro.props;

// خروجی build از نوع directory است؛ پس canonical همیشه با `/` تمام می‌شود
// تا با آدرس واقعی سرو‌شده و آدرس داخل sitemap دقیقاً یکی باشد.
const canonicalURL = new URL(
  canonicalPathname(canonicalPath ?? Astro.url.pathname),
  SITE.url,
);
const ogImageURL = new URL(ogImage, SITE.url);

// به گوگل اجازه‌ی نمایش تصویر بزرگ و اسنیپت کامل را می‌دهد؛
// بدون این دستور، اسنیپت فارسی معمولاً کوتاه بریده می‌شود.
const robotsContent = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

// Organization و WebSite در همه‌ی صفحات تکرار می‌شوند اما با `@id` یکسان،
// پس گوگل آن‌ها را یک موجودیت واحد می‌بیند و schema تکراری ساخته نمی‌شود.
const pageSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const jsonLdGraph = [websiteSchema, organizationSchema, ...pageSchemas];
---

<!DOCTYPE html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#110e2d" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content={String(SITE.ogImageWidth)} />
    <meta property="og:image:height" content={String(SITE.ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.name} />
    {ogType === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === "article" && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Icons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content={SITE.name} />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`بلاگ ${SITE.name}`}
      href="/rss.xml"
    />

    {preloadImage && (
      <link rel="preload" href={preloadImage} as="image" fetchpriority="high" />
    )}

    <link
      rel="preload"
      href="/fonts/IranYekanX/IRANYekanXFaNum-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Rokh/Rokh-ExtraBold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <JsonLd schema={jsonLdGraph} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">رفتن به محتوای اصلی</a>
    <slot />
  </body>
</html>
