---
import "../styles/global.css";
import JsonLd from "../components/seo/JsonLd.astro";
import {
  SITE,
  canonicalPathname,
  organizationSchema,
  websiteSchema,
} from "../data/site";

interface Props {
  title: string;
  description: string;
  ogImage?: string;      // مسیر نسبی، مثلاً "/images/og-default.jpg"
  ogImageAlt?: string;
  ogType?: "website" | "article";
  canonicalPath?: string; // مثلاً "/pricing" — اگر ندی، از Astro.url ساخته می‌شه
  noindex?: boolean;
  schema?: Record<string, any> | Record<string, any>[]; // JSON-LD اختصاصی صفحه
  /** متادیتای مقاله؛ فقط وقتی ogType === "article" معنی دارد */
  publishedTime?: string;
  modifiedTime?: string;
  /** تصویر LCP صفحه؛ فقط برای صفحه‌ای بده که تصویر بزرگ above-the-fold دارد */
  preloadImage?: string;
}

const {
  title,
  description,
  ogImage = SITE.ogImage,
  ogImageAlt = `${SITE.name} — نرم‌افزار مدیریت تعمیرگاه`,
  ogType = "website",
  canonicalPath,
  noindex = false,
  schema,
  publishedTime,
  modifiedTime,
  preloadImage,
} = Astro.props;

// خروجی build از نوع directory است؛ پس canonical همیشه با `/` تمام می‌شود
// تا با آدرس واقعی سرو‌شده و آدرس داخل sitemap دقیقاً یکی باشد.
const canonicalURL = new URL(
  canonicalPathname(canonicalPath ?? Astro.url.pathname),
  SITE.url,
);
const ogImageURL = new URL(ogImage, SITE.url);

// به گوگل اجازه‌ی نمایش تصویر بزرگ و اسنیپت کامل را می‌دهد؛
// بدون این دستور، اسنیپت فارسی معمولاً کوتاه بریده می‌شود.
const robotsContent = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

// Organization و WebSite در همه‌ی صفحات تکرار می‌شوند اما با `@id` یکسان،
// پس گوگل آن‌ها را یک موجودیت واحد می‌بیند و schema تکراری ساخته نمی‌شود.
const pageSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const jsonLdGraph = [websiteSchema, organizationSchema, ...pageSchemas];
---

<!DOCTYPE html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#110e2d" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content={String(SITE.ogImageWidth)} />
    <meta property="og:image:height" content={String(SITE.ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.name} />
    {ogType === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === "article" && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Icons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content={SITE.name} />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`بلاگ ${SITE.name}`}
      href="/rss.xml"
    />

    {preloadImage && (
      <link rel="preload" href={preloadImage} as="image" fetchpriority="high" />
    )}

    <link
      rel="preload"
      href="/fonts/IranYekanX/IRANYekanXFaNum-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Rokh/Rokh-ExtraBold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <JsonLd schema={jsonLdGraph} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">رفتن به محتوای اصلی</a>
    <slot />
    <script>
      // ردیابی منبع تبلیغ (UTM) تا مرز ثبت‌نام: اگر utm_* در URL این بازدید
      // باشد ذخیره می‌شود (حداکثر ۳۰ روز، هم‌اندازه‌ی دوره‌ی آزمایشی رایگان)
      // و به هر لینک ثبت‌نام در صفحه چسبانده می‌شود؛ وگرنه از بازدید قبلی
      // (در همین ۳۰ روز) خوانده می‌شود. اپ باید این پارامترها را در لحظه‌ی
      // ثبت‌نام بخواند و ذخیره کند — آن قسمت در ریپوی دیگری است.
      const UTM_KEYS = ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term"];
      const STORAGE_KEY = "dofixo_utm";
      const MAX_AGE_MS = 30 * 24 * 60 * 60 * 1000;

      function readStored(): Record<string, string> | null {
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          if (!raw) return null;
          const parsed = JSON.parse(raw);
          if (Date.now() - parsed.savedAt > MAX_AGE_MS) return null;
          return parsed.values;
        } catch {
          return null;
        }
      }

      function storeFromUrl(): Record<string, string> | null {
        const params = new URLSearchParams(location.search);
        const values: Record<string, string> = {};
        for (const key of UTM_KEYS) {
          const value = params.get(key);
          if (value) values[key] = value;
        }
        if (Object.keys(values).length === 0) return null;
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify({ savedAt: Date.now(), values }));
        } catch {
          // localStorage در دسترس نیست (مثلاً حالت خصوصی)؛ این بازدید فقط بدون ردیابی می‌ماند
        }
        return values;
      }

      const utm = storeFromUrl() ?? readStored();
      if (utm) {
        document.querySelectorAll('a[href^="https://app.dofixo.ir/register"]').forEach((a) => {
          const href = a.getAttribute("href");
          if (!href) return;
          const url = new URL(href, location.href);
          for (const [key, value] of Object.entries(utm)) {
            if (!url.searchParams.has(key)) url.searchParams.set(key, value);
          }
          a.setAttribute("href", url.toString());
        });
      }
    </script>
  </body>
</html>
