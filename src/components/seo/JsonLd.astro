---
interface Props {
  schema?: Record<string, any> | Record<string, any>[];
}
const { schema } = Astro.props;

// ورودی خالی یا آیتم‌های falsy حذف می‌شوند تا تگ <script> بی‌محتوا تولید نشود.
const schemas = (Array.isArray(schema) ? schema : [schema]).filter(Boolean) as Record<
  string,
  any
>[];
---

{schemas.map((s) => (
  <script type="application/ld+json" set:html={JSON.stringify(s)} />
))}
