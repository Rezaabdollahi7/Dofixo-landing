---
import { Image } from "astro:assets";

interface Props {
  href: string;
  title: string;
  description: string;
  publishDate: Date;
  tags: string[];
  coverImage?: any;
  coverImageAlt?: string;
  icon?: "repair" | "inventory" | "pricing" | "customer" | "general";
}

const { href, title, description, publishDate, tags, coverImage, coverImageAlt, icon = "general" } = Astro.props;

const formattedDate = new Intl.DateTimeFormat("fa-IR", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(publishDate);
---

<a
  href={href}
  class="group block bg-white rounded-[20px] sm:rounded-[30px] shadow-2 hover:shadow-8 transition-all duration-300 overflow-hidden h-full flex flex-col"
>
  <div class="aspect-[16/9] w-full overflow-hidden bg-[#EE5D38]">
    {
      coverImage ? (
        <Image
          src={coverImage}
          alt={coverImageAlt ?? title}
          width={640}
          height={360}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
      ) : (
        <img
          src={`/images/blog-covers/cover-${icon}.svg`}
          alt={coverImageAlt ?? title}
          width="640"
          height="360"
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
      )
    }
  </div>

  <div class="p-5 sm:p-6 flex flex-col flex-grow">
    {
      tags?.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-3">
          {tags.slice(0, 2).map((tag: string) => (
            <span class="text-[11px] font-bold text-secondary bg-[#fdeeea] rounded-full px-3 py-1">
              {tag}
            </span>
          ))}
        </div>
      )
    }

    <h3 class="font-heading font-extrabold text-lg text-primary leading-[145%] group-hover:text-secondary transition-colors">
      {title}
    </h3>

    <p class="text-primary/60 text-sm leading-[190%] mt-2 line-clamp-2 flex-grow">
      {description}
    </p>

    <div class="flex items-center gap-2 mt-4 pt-4 border-t border-[#110e2d0d]">
      <svg width="16" height="16" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" class="opacity-40">
        <path d="M6.66667 1.66669V4.16669M13.3333 1.66669V4.16669M2.91667 7.57502H17.0833M17.5 7.08335V14.1667C17.5 16.6667 16.25 18.3334 13.3333 18.3334H6.66667C3.75 18.3334 2.5 16.6667 2.5 14.1667V7.08335C2.5 4.58335 3.75 2.91669 6.66667 2.91669H13.3333C16.25 2.91669 17.5 4.58335 17.5 7.08335Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="text-xs text-primary/50 font-medium">{formattedDate}</span>
    </div>
  </div>
</a>
