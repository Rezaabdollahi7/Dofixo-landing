---
// src/components/sections/FeaturesSlides.astro
//
// «از پراکندگی به نظم»: پنج ماژول اصلی، هر کدام با تصویر واقعی خودش.
//
// قبلاً اسلایدری بود که هر پنج ثانیه خودش جلو می‌رفت و متن بلندش وسط خواندن
// عوض می‌شد. حالا زبانه است: تا خواننده خودش زبانه‌ی دیگری را نزند چیزی
// تکان نمی‌خورد، و متن هر ماژول یک جمله و چهار مورد کوتاه است.
//
// همه‌ی پنل‌ها در یک خانه‌ی گرید روی هم‌اند، پس ارتفاع بخش با عوض شدن زبانه
// تغییر نمی‌کند و صفحه زیر دست خواننده نمی‌پرد. هر ادعا باید در
// docs/academy/product-facts.md پشتوانه داشته باشد.
import { Image } from "astro:assets";
import { screens, type AppScreen } from "../../data/appScreens";
import DeviceSvg from "../../../public/icons/img_89.svg?raw";
import CustomerSvg from "../../../public/icons/img_84.svg?raw";
import InventorySvg from "../../../public/icons/img_27.svg?raw";
import InvoiceSvg from "../../../public/icons/img_81.svg?raw";
import DashboardSvg from "../../../public/icons/img_88.svg?raw";

interface Module {
  id: string;
  title: string;
  titleEn: string;
  icon: string;
  lead: string;
  points: string[];
  screen: AppScreen;
  link: { href: string; label: string };
}

const modules: Module[] = [
  {
    id: "devices",
    title: "مدیریت دستگاه‌ها",
    titleEn: "Devices",
    icon: DeviceSvg,
    lead: "هر دستگاه از لحظه‌ی پذیرش تا تحویل یک شماره و یک پرونده دارد؛ کسی لازم نیست دنبال دفتر بگردد تا بفهمد کار به کجا رسیده.",
    points: [
      "شماره‌ی پذیرش پشت‌سرهم، که روی فاکتور و پیامک مشتری هم می‌آید",
      "وضعیت هر دستگاه، از «در انتظار بررسی» تا «تحویل داده شده»",
      "سپردن دستگاه به تعمیرکار، با تاریخچه‌ی سپردن‌ها",
      "پیامک خودکار به مشتری هنگام پذیرش، آماده‌بودن و تحویل",
    ],
    screen: screens.devices,
    link: { href: "/academy/tutorials/device-intake/", label: "آموزش پذیرش دستگاه" },
  },
  {
    id: "customers",
    title: "مدیریت مشتریان",
    titleEn: "Customers",
    icon: CustomerSvg,
    lead: "سابقه‌ی هر مشتری در یک صفحه: چه دستگاه‌هایی آورده، چه تعمیری شده و چقدر پرداخته.",
    points: [
      "همه‌ی دستگاه‌های مشتری و خط زمانی تعمیرهایش",
      "فاکتورها و مانده‌ی پرداخت‌نشده",
      "یادداشت خصوصی، که فقط کارکنان می‌بینند و روی فاکتور نمی‌آید",
      "پیدا کردن مشتری با نام یا شماره تماس",
    ],
    screen: screens.customerPage,
    link: { href: "/features/", label: "همه‌ی امکانات" },
  },
  {
    id: "inventory",
    title: "مدیریت انبار",
    titleEn: "Inventory",
    icon: InventorySvg,
    lead: "موجودی قطعه‌ها با هر فاکتور خودکار به‌روز می‌شود؛ برای دانستن اینکه چه دارید، لازم نیست قفسه را بشمارید.",
    points: [
      "کد، دسته‌بندی، واحد و حداقل موجودی برای هر کالا",
      "موجودی با فاکتور خرید زیاد و با فروش و تعمیر کم می‌شود",
      "قیمت تمام‌شده با میانگین موزون خریدها",
      "کالاهای کم‌موجود در داشبورد و گزارش موجودی",
    ],
    screen: screens.items,
    link: { href: "/features/", label: "همه‌ی امکانات" },
  },
  {
    id: "invoices",
    title: "صدور فاکتور",
    titleEn: "Invoices",
    icon: InvoiceSvg,
    lead: "فاکتور خرید، فروش و تعمیر با شماره‌ی پشت‌سرهم، و چاپ با لوگو و اطلاعات تعمیرگاه خودتان.",
    points: [
      "قطعه و اجرت در فاکتور تعمیر، با تخفیف و مالیات",
      "پرداخت نقدی، کارتی یا انتقال وجه، در یک یا چند نوبت",
      "گارانتی با تاریخ پایان خودکار، روی فاکتور چاپی",
      "ویرایش هر فاکتور، که انبار را هم هم‌پایش اصلاح می‌کند",
    ],
    screen: screens.repairInvoice,
    link: { href: "/features/", label: "همه‌ی امکانات" },
  },
  {
    id: "reports",
    title: "گزارش‌ها و داشبورد",
    titleEn: "Reports",
    icon: DashboardSvg,
    lead: "وضعیت تعمیرگاه در یک نگاه، و سود واقعی هر ماه از روی فاکتورها — نه از روی حدس.",
    points: [
      "دستگاه‌های در کار، بار کاری تعمیرکارها و درآمد امروز و این ماه",
      "سود و زیان در هر بازه‌ی تاریخ، به تفکیک کالا",
      "ارزش ریالی انبار در گزارش موجودی",
      "نرخ تعمیر موفق و میانگین زمان تعمیر هر تعمیرکار",
    ],
    screen: screens.dashboard,
    link: { href: "/features/", label: "همه‌ی امکانات" },
  },
];

const toFa = (n: number) => n.toLocaleString("fa-IR", { minimumIntegerDigits: 2 });
---

<section class="mt-42" dir="rtl" id="modules">
  <div class="container mx-auto mt-2 mb-8 md:mb-12 text-center px-4">
    <h2 class="text-3xl md:text-4xl lg:text-5xl font-heading font-extrabold text-secondary mb-4 md:mb-6">
      «از پراکندگی به نظم ، با دوفیکسو»
    </h2>
    <p class="text-base md:text-lg text-charcoal/70 max-w-2xl mx-auto">
      دستگاه‌ها، مشتری‌ها، انبار، فاکتورها و گزارش‌ها — به‌جای دفتر و اکسل و کاغذهای پراکنده، در یک پنل
    </p>
  </div>

  <div class="max-w-content mx-auto px-4">
    <!-- زبانه‌ها. روی گوشی افقی اسکرول می‌شوند. -->
    <div class="flex justify-center">
      <div
        role="tablist"
        aria-label="ماژول‌های دوفیکسو"
        class="mod-tabs flex gap-1.5 p-1.5 bg-white rounded-full border border-lavender shadow-[0_8px_30px_-12px_rgba(17,14,45,0.15)] max-w-full overflow-x-auto snap-x"
      >
        {modules.map((m, i) => (
          <button
            type="button"
            role="tab"
            id={`mod-tab-${m.id}`}
            aria-controls={`mod-panel-${m.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
            class="mod-tab snap-start shrink-0 flex items-center gap-2 rounded-full px-4 sm:px-5 h-11 sm:h-12 text-sm sm:text-[15px] font-bold whitespace-nowrap cursor-pointer transition-colors duration-200 text-primary/60 hover:text-primary hover:bg-[#f1f4f7] aria-selected:bg-primary aria-selected:text-white aria-selected:hover:bg-primary"
          >
            <span class="mod-tab-icon size-5 shrink-0 [&_svg]:size-full [&_svg_path]:stroke-current" set:html={m.icon} />
            {m.title}
          </button>
        ))}
      </div>
    </div>

    <!-- پنل‌ها، همه در یک خانه‌ی گرید -->
    <div class="grid mt-6 sm:mt-10">
      {modules.map((m, i) => (
        <div
          role="tabpanel"
          id={`mod-panel-${m.id}`}
          aria-labelledby={`mod-tab-${m.id}`}
          data-active={i === 0 ? "true" : "false"}
          class="mod-panel [grid-area:1/1] bg-white rounded-[24px] sm:rounded-[32px] border border-lavender shadow-[0_30px_80px_-40px_rgba(17,14,45,0.25)] p-4 sm:p-8 lg:p-10 grid lg:grid-cols-12 gap-6 lg:gap-10 content-start lg:content-center items-center"
        >
          <div class="lg:col-span-5 order-2 lg:order-1">
            <p class="flex items-center gap-2 text-xs font-bold tracking-widest uppercase">
              <span class="text-secondary">{toFa(i + 1)}</span>
              <span class="h-px w-6 bg-secondary/40"></span>
              <span class="text-primary/40" dir="ltr">{m.titleEn}</span>
            </p>
            <h3 class="mt-3 font-heading font-extrabold text-2xl sm:text-3xl text-primary">{m.title}</h3>
            <p class="mt-3 text-[15px] sm:text-base leading-[200%] text-charcoal/80">{m.lead}</p>
            <ul class="mt-5 space-y-3">
              {m.points.map((p) => (
                <li class="flex items-start gap-3 text-[14px] sm:text-[15px] leading-[180%] text-primary/85">
                  <span class="mt-0.5 size-5 shrink-0 rounded-full bg-linen-1 text-secondary flex items-center justify-center">
                    <svg class="size-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </span>
                  {p}
                </li>
              ))}
            </ul>
            <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
              <a
                href="https://app.dofixo.ir/register"
                rel="noopener"
                class="bg-secondary btnHover inline-flex items-center justify-center h-12 px-7 rounded-[12px] text-white font-bold"
              >
                شروع ۳۰ روز رایگان
              </a>
              <a href={m.link.href} class="inline-flex items-center gap-1.5 text-sm font-bold text-primary hover:text-secondary transition-colors">
                {m.link.label}
                <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
              </a>
            </div>
          </div>

          <div class="lg:col-span-7 order-1 lg:order-2">
            <div class="rounded-[16px] sm:rounded-[22px] bg-[#F1F4F7] p-2 sm:p-3">
              <div class="rounded-[10px] sm:rounded-[14px] overflow-hidden bg-white border border-lavender-1 shadow-[0_20px_40px_-24px_rgba(17,14,45,0.35)]">
                <div class="flex items-center gap-1.5 px-3 h-6 sm:h-7 bg-[#f7f8fa] border-b border-lavender-1" dir="ltr" aria-hidden="true">
                  <i class="size-2 sm:size-2.5 rounded-full bg-[#ff5f57]"></i>
                  <i class="size-2 sm:size-2.5 rounded-full bg-[#febc2e]"></i>
                  <i class="size-2 sm:size-2.5 rounded-full bg-[#28c840]"></i>
                </div>
                <Image
                  src={m.screen.image}
                  alt={`${m.screen.title} در نرم‌افزار دوفیکسو: ${m.screen.caption}`}
                  widths={[640, 960, 1440]}
                  sizes="(min-width: 1280px) 680px, (min-width: 1024px) 55vw, 92vw"
                  loading="lazy"
                  class="w-full h-auto block"
                />
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .mod-tabs {
    scrollbar-width: none;
  }
  .mod-tabs::-webkit-scrollbar {
    display: none;
  }
  @media (max-width: 767px) {
    /* زبانه‌های بعدی از لبه‌ی چپ بیرون می‌زنند؛ محو شدن لبه نشان می‌دهد که ادامه دارد */
    .mod-tabs {
      mask-image: linear-gradient(to right, transparent 0, #000 28px);
    }
  }
  .mod-panel {
    transition: opacity 0.35s ease, transform 0.35s ease, visibility 0s linear 0.35s;
  }
  .mod-panel[data-active="false"] {
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    pointer-events: none;
  }
  .mod-panel[data-active="true"] {
    transition-delay: 0s;
  }
  @media (prefers-reduced-motion: reduce) {
    .mod-panel { transition: none; }
  }
</style>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>(".mod-tab")];
  const panels = [...document.querySelectorAll<HTMLElement>(".mod-panel")];

  const select = (i: number, focus = false) => {
    tabs.forEach((t, k) => {
      const on = k === i;
      t.setAttribute("aria-selected", String(on));
      t.tabIndex = on ? 0 : -1;
    });
    panels.forEach((p, k) => (p.dataset.active = String(k === i)));
    // زبانه‌ی انتخاب‌شده روی گوشی دیده شود، بی‌آنکه صفحه عمودی بپرد
    const tab = tabs[i];
    const bar = tab.parentElement!;
    bar.scrollTo({ left: tab.offsetLeft - (bar.clientWidth - tab.offsetWidth) / 2, behavior: "smooth" });
    if (focus) tab.focus();
  };

  tabs.forEach((t, i) => {
    t.addEventListener("click", () => select(i));
    // صفحه راست‌به‌چپ است: جهت چپ یعنی زبانه‌ی بعدی
    t.addEventListener("keydown", (e) => {
      const n = tabs.length;
      const go = { ArrowLeft: i + 1, ArrowRight: i - 1, Home: 0, End: n - 1 }[e.key];
      if (go === undefined) return;
      e.preventDefault();
      select((go + n) % n, true);
    });
  });
</script>
