---
// src/components/sections/ArticleIllustration.astro
interface Props {
  topic: "repair" | "inventory" | "pricing" | "customer" | "general";
  label: string;
}

const { topic, label } = Astro.props;
---

<div class="rounded-[20px] bg-gradient-to-br from-[#fdeeea] to-[#fcdfd7] p-6 flex flex-col items-center justify-center aspect-[4/3] shadow-2">
  {topic === "repair" && (
    <svg width="72" height="72" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94L14.7 6.3z" stroke="#EE5D38" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  )}
  {topic === "inventory" && (
    <svg width="72" height="72" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M3 7l9-4 9 4-9 4-9-4z" stroke="#EE5D38" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M3 7v10l9 4 9-4V7M12 11v10" stroke="#EE5D38" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  )}
  {topic === "pricing" && (
    <svg width="72" height="72" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="8" cy="8" r="5.5" stroke="#EE5D38" stroke-width="1.5"/>
      <circle cx="15" cy="15" r="5.5" stroke="#EE5D38" stroke-width="1.5" opacity="0.5"/>
      <path d="M8 6v4M6 8h4" stroke="#EE5D38" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  )}
  {topic === "customer" && (
    <svg width="72" height="72" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="9" cy="8" r="3.25" stroke="#EE5D38" stroke-width="1.5"/>
      <path d="M3.5 19c0-3.038 2.462-5.5 5.5-5.5s5.5 2.462 5.5 5.5" stroke="#EE5D38" stroke-width="1.5" stroke-linecap="round"/>
      <circle cx="17" cy="7" r="2.5" stroke="#EE5D38" stroke-width="1.5" opacity="0.5"/>
      <path d="M15.5 13.25c2.485 0 4.5 2.015 4.5 5.75" stroke="#EE5D38" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>
    </svg>
  )}
  {topic === "general" && (
    <svg width="72" height="72" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="3.5" y="4" width="17" height="16" rx="2.5" stroke="#EE5D38" stroke-width="1.5"/>
      <path d="M7.5 9h9M7.5 13h9M7.5 17h5.5" stroke="#EE5D38" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  )}
  <p class="mt-4 text-xs font-bold text-secondary text-center">{label}</p>
</div>
