---
// src/components/sections/Screenshots.astro
//
// اسکرین‌شات‌های واقعی اپ (src/data/appScreens.ts). کلیک روی هر کارت آن را در
// لایت‌باکس تمام‌صفحه (ui/ShotLightbox.astro) باز می‌کند.
import { Image } from "astro:assets";
import { gallery } from "../../data/appScreens";
import ShotLightbox from "../ui/ShotLightbox.astro";

const toFa = (n: number) => n.toLocaleString("fa-IR");
---

<section id="screenshots" class="max-w-content mx-auto px-4 relative mt-42">
  <div class="text-center mb-12">
    <h2 class="text-2xl md:text-3xl lg:text-4xl font-heading font-extrabold text-primary">
      اسکرین شات هایی از
      <span class="text-secondary">دوفیکسو</span>
    </h2>
    <p class="text-charcoal/60 text-base md:text-lg mt-3 max-w-2xl mx-auto">
      تصویرهای واقعی از بخش‌های مختلف نرم‌افزار، روی اطلاعات یک تعمیرگاه موبایل نمونه. برای دیدن جزئیات روی هر تصویر بزنید.
    </p>
  </div>

  <!-- لایه‌های تزیینی بالای کارت -->
  <div class="rounded-t-[20px] sm:rounded-t-[30px] bg-[#fcfcfc] shadow-2 z-1 h-5 mx-[59px] relative"></div>
  <div class="rounded-t-[20px] sm:rounded-t-[30px] bg-[#f4f4f4] shadow-2 h-5 mx-[30px] relative"></div>

  <div class="rounded-[20px] sm:rounded-[30px] bg-white shadow-2 p-3 sm:p-[30px] relative">
    <ul class="bg-[#F1F4F7] rounded-[16px] sm:rounded-[24px] p-3 sm:p-5 lg:p-7 grid grid-cols-2 lg:grid-cols-3 gap-2.5 sm:gap-5 xl:gap-7">
      {gallery.map((s, i) => (
        <li>
          <button
            type="button"
            class="group w-full text-right rounded-[16px] sm:rounded-[20px] bg-white p-2 sm:p-2.5 shadow-[0_1px_2px_rgba(17,14,45,0.06)] hover:shadow-[0_18px_40px_-18px_rgba(17,14,45,0.35)] hover:-translate-y-1 transition-all duration-300 cursor-zoom-in focus-visible:outline-2 focus-visible:outline-secondary"
            data-shot={i}
            aria-label={`بزرگ‌نمایی تصویر ${s.title}`}
          >
            <span class="block relative overflow-hidden rounded-[11px] sm:rounded-[14px] border border-lavender-1 aspect-[16/10] bg-[#f6f8fb]">
              <Image
                src={s.image}
                alt={`${s.title} در نرم‌افزار دوفیکسو: ${s.caption}`}
                widths={[480, 800, 1200]}
                sizes="(min-width: 1024px) 380px, 46vw"
                loading="lazy"
                class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.04]"
              />
              <span class="absolute inset-0 bg-primary/0 group-hover:bg-primary/25 transition-colors duration-300 flex items-center justify-center">
                <span class="size-11 rounded-full bg-white/95 text-primary flex items-center justify-center opacity-0 scale-75 group-hover:opacity-100 group-hover:scale-100 transition-all duration-300 shadow-lg">
                  <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" /><path stroke-linecap="round" d="M20 20l-3.5-3.5M11 8v6M8 11h6" />
                  </svg>
                </span>
              </span>
            </span>
            <span class="flex items-center gap-2 sm:gap-2.5 px-1 sm:px-1.5 pt-2.5 sm:pt-3 pb-1 sm:pb-1.5">
              <span class="shrink-0 size-5 sm:size-6 rounded-full bg-primary text-white text-[10px] sm:text-[11px] font-bold flex items-center justify-center">{toFa(i + 1)}</span>
              <span class="font-heading font-bold text-[13px] sm:text-[15px] text-primary leading-snug">{s.title}</span>
            </span>
            <span class="hidden sm:block px-1.5 pb-1 text-[13px] leading-[190%] text-charcoal/70">{s.caption}</span>
          </button>
        </li>
      ))}
    </ul>
  </div>

  <ShotLightbox shots={gallery} />
</section>
