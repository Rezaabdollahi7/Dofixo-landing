---
/**
 * یادداشت کنار متن:
 * - tip «نکته»: میان‌بُر
 * - warning «هشدار»: اشتباهی که گران تمام می‌شود
 * - benefit «چرا مهم است»: این قابلیت چه مشکلی از تعمیرگاه حل می‌کند — نه
 *   اینکه دکمه کجاست، بلکه اینکه چرا ارزش زدنش را دارد
 */
interface Props {
  type?: "tip" | "warning" | "benefit";
  title?: string;
}
const { type = "tip", title } = Astro.props;
const label = title ?? (type === "warning" ? "هشدار" : type === "benefit" ? "چرا مهم است" : "نکته");
const styles =
  type === "warning"
    ? "bg-[#fdeeea] border-secondary"
    : type === "benefit"
      ? "bg-[#eef8f2] border-[#2f9e62]"
      : "bg-[#f0f4fa] border-primary/30";
---

<aside class={`not-prose my-8 rounded-[16px] border-r-4 ${styles} p-5`} role="note">
  <p class="font-bold text-primary text-sm mb-1">{label}</p>
  <div class="text-sm text-primary/75 leading-[210%] [&_p]:mb-2 [&_a]:text-secondary [&_a]:font-bold [&_a]:underline">
    <slot />
  </div>
</aside>
